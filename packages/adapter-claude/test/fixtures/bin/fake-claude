#!/bin/sh
# Synthetic stand-in for `claude agents --json --all`, used by tests only.
if [ "$1" = "agents" ] && [ "$2" = "--json" ] && [ "$3" = "--all" ]; then
  cat <<'JSON'
[{"pid":4242,"cwd":"/Users/test/alpha","kind":"interactive","startedAt":1768039200000,"sessionId":"11111111-1111-4111-8111-111111111111","name":"alpha work","status":"busy","futureKey":1},
 {"id":"bg_1","cwd":"/Users/test/alpha","kind":"background","startedAt":1768039200000,"sessionId":"55555555-5555-4555-8555-555555555555","name":"bg job","state":"failed"},
 "not-an-object"]
JSON
  exit 0
fi
echo "unexpected arguments" >&2
exit 2
